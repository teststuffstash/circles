{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "_comment": "python rides a nixpkgs FLAKE REF (3.15.0 final) because devbox's search index lagged at 3.15.0rc2 — the homelab#2610 pattern; swap back to `python@3.15` once `devbox search python@3.15` resolves the final. VENV_DIR is keyed on the interpreter minor so a cached venv from another python on a persistent runner is never reused (homelab#2757).",
  "packages": [
    "kubectl@latest",
    "uv@latest",
    "gitleaks@latest",
    "kubernetes-helm@latest",
    "kubernetes-helmPlugins.helm-unittest@latest",
    "kubeconform@latest",
    "goose-cli@latest",
    "gh@latest",
    "kind@latest",
    "docker-client@latest",
    "minio-client@latest",
    "rclone@latest",
    "github:NixOS/nixpkgs/f05535a0efcb2134c478d1e88434fadf486d42b5#python315"
  ],
  "env": {
    "VENV_DIR": "$HOME/.cache/devbox-venv/circles-py3.15"
  },
  "shell": {
    "init_hook": [],
    "scripts": {
      "ci":             ["./scripts/ci.sh"],
      "pr-gate": [
        "./scripts/ci.sh && devbox run scan-secrets"
      ],
      "test-chart":     ["./scripts/test-chart.sh"],
      "test-system":    ["./scripts/test-system.sh"],
      "test-browser":   ["./scripts/test-browser.sh"],
      "scan-secrets":   ["gitleaks detect --source . --no-banner --verbose"],
      "validate-chart": ["./scripts/validate-chart.sh"],
      "build-image":    ["./scripts/build-image.sh"],
      "package-chart":  ["./scripts/package-chart.sh"],
      "evidence":       ["./scripts/evidence.sh \"$@\""],
      "specs-build":    ["./scripts/specs-build.sh"],
      "specs-publish":  ["./scripts/specs-publish.sh"]
    }
  }
}
