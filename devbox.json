{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "kubectl@latest",
    "uv@latest",
    "gitleaks@latest",
    "kubernetes-helm@latest",
    "kubernetes-helmPlugins.helm-unittest@latest",
    "kubeconform@latest",
    "goose-cli@latest",
    "gh@latest",
    "kind@latest",
    "docker-client@latest",
    "minio-client@latest",
    "python@3.15"
  ],
  "env": {
    "VENV_DIR": "$HOME/.cache/devbox-venv/circles"
  },
  "shell": {
    "init_hook": [],
    "scripts": {
      "ci":             ["./scripts/ci.sh"],
      "test-chart":     ["./scripts/test-chart.sh"],
      "test-system":    ["./scripts/test-system.sh"],
      "test-browser":   ["./scripts/test-browser.sh"],
      "scan-secrets":   ["gitleaks detect --source . --no-banner --verbose"],
      "validate-chart": ["./scripts/validate-chart.sh"],
      "build-image":    ["./scripts/build-image.sh"],
      "package-chart":  ["./scripts/package-chart.sh"],
      "evidence":       ["./scripts/evidence.sh \"$@\""],
      "specs-build":    ["./scripts/specs-build.sh"],
      "specs-publish":  ["./scripts/specs-publish.sh"]
    }
  }
}
